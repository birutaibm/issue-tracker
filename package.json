{
  "name": "issue-tracker-mcp",
  "version": "1.0.0",
  "description": "MCP server for issue-tracker file operations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx src/index.ts",
    "dev:client": "vite --port 5173 --host --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "vite build --config client/vite.config.ts --outDir ../dist/client",
    "start": "node dist/index.js",
    "lint": "eslint src/ client/src/ e2e/",
    "lint:fix": "eslint src/ client/src/ e2e/ --fix",
    "format": "prettier --write src/ client/ e2e/",
    "format:check": "prettier --check src/ client/ e2e/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "issue-tracker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dompurify": "^3.1.0",
    "express": "^4.19.2",
    "jsdom": "^24.0.0",
    "knex": "^3.3.0",
    "marked": "^12.0.0",
    "mermaid": "^10.9.0",
    "mime-types": "^2.1.35",
    "shiki": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "pinia": "^2.1.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  }
}
